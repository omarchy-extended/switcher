{
  // The omarchy-extended group, in Setup (every omext addon has it; any one keeps it).
  "setup.omext": {"icon": "", "label": "Omarchy Extended", "description": "The omarchy-extended addons, on or off", "aliases": ["omext", "extended"]},
  // The switcher, on or off (Hyprland reads its keys again: Alt + Tab is the switcher's, or Omarchy's).
  "setup.omext.switcher": {"icon": "󰖲", "label": "Switcher", "description": "Alt + Tab shows the open windows, last used first, to step through while Alt is held", "action": "if omarchy plugin list --json | jq -e '.[] | select(.id == \"omext.switcher\") | .enabled' >/dev/null; then omarchy plugin disable omext.switcher >/dev/null; m=\"Turned off: Alt + Tab is Omarchy's again\"; else omarchy plugin enable omext.switcher >/dev/null; m=\"Turned on\"; fi; sleep 0.5; hyprctl reload >/dev/null; notify-send Switcher \"$m\"", "checked": "omarchy plugin list --json | jq -e '.[] | select(.id == \"omext.switcher\") | .enabled' >/dev/null"},
  "setup.omext.switcher-docked": {"icon": "󰘔", "label": "Switcher: Dock Apps", "description": "The omext docks' apps are in the list too", "action": "if [ \"$(omext-settings get switcher docked | tr -d ' \\n')\" = false ]; then omext-settings set switcher docked true; m=\"In the list\"; else omext-settings set switcher docked false; m=\"Left out\"; fi; notify-send Switcher \"Dock apps: $m\"", "when": "omarchy plugin list --json | jq -e '.[] | select(.id == \"omext.switcher\") | .enabled' >/dev/null", "checked": "[ \"$(omext-settings get switcher docked | tr -d ' \\n')\" != false ]"},
  "setup.omext.switcher-minimized": {"icon": "󰖰", "label": "Switcher: Minimized Windows", "description": "The minimized windows are in the list too", "action": "if [ \"$(omext-settings get switcher minimized | tr -d ' \\n')\" = false ]; then omext-settings set switcher minimized true; m=\"In the list\"; else omext-settings set switcher minimized false; m=\"Left out\"; fi; notify-send Switcher \"Minimized windows: $m\"", "when": "omarchy plugin list --json | jq -e '.[] | select(.id == \"omext.switcher\") | .enabled' >/dev/null", "checked": "[ \"$(omext-settings get switcher minimized | tr -d ' \\n')\" != false ]"}
}
